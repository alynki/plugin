{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}\"/alynki-plugin/hooks/session-start.sh codex session"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}\"/alynki-plugin/hooks/session-start.sh codex subagent"
          }
        ]
      }
    ]
  }
}
